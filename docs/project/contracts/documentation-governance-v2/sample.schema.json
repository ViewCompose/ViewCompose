{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.viewcompose.com/contracts/documentation-governance-v2/sample.schema.json",
  "title": "ViewCompose documentation sample contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "sample_class",
    "language",
    "capability_id",
    "document_ids",
    "version_lane"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "sample_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
    "sample_class": { "enum": ["compiled-region", "generated-signature", "non-executable"] },
    "language": { "enum": ["kotlin", "java", "text"] },
    "capability_id": { "type": "string", "minLength": 3 },
    "document_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "version_lane": { "enum": ["released", "next", "version-agnostic"] },
    "source": { "type": "string", "pattern": "^[^*?\\[\\]{}]+$" },
    "region": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "build_target": { "type": "string", "pattern": "^:[a-zA-Z0-9:_-]+$" },
    "symbol_id": { "type": "string", "minLength": 3 },
    "generator": { "type": "string", "minLength": 3 },
    "reason": { "type": "string", "minLength": 12 },
    "visible_explanation": { "type": "string", "minLength": 12 }
  },
  "allOf": [
    {
      "if": { "properties": { "sample_class": { "const": "compiled-region" } }, "required": ["sample_class"] },
      "then": {
        "required": ["source", "region", "build_target"],
        "properties": { "language": { "enum": ["kotlin", "java"] } }
      }
    },
    {
      "if": { "properties": { "sample_class": { "const": "generated-signature" } }, "required": ["sample_class"] },
      "then": { "required": ["symbol_id", "generator"] }
    },
    {
      "if": { "properties": { "sample_class": { "const": "non-executable" } }, "required": ["sample_class"] },
      "then": { "required": ["reason", "visible_explanation"] }
    }
  ]
}
