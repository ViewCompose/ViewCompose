{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viewcompose.com/ai/evaluation-corpus-v1.schema.json",
  "title": "ViewCompose AI evaluation corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "versionLane", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "$ref": "#/$defs/stableId" },
    "versionLane": { "enum": ["current-source", "released"] },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "category", "input", "expected", "metricIds"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "phase": { "type": "integer", "minimum": 1, "maximum": 6 },
          "category": {
            "enum": [
              "retrieval",
              "knowledge-freshness",
              "hallucination",
              "static-validation",
              "compilation",
              "render",
              "project-analysis",
              "security",
              "protocol",
              "xml-migration",
              "compose-migration",
              "visual-generation"
            ]
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["query", "fixture"] },
              "text": { "type": "string", "minLength": 1 },
              "fixture": { "type": "string", "minLength": 1 }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "evidenceLevel"],
            "properties": {
              "outcome": { "enum": ["pass", "fail", "unsupported"] },
              "evidenceLevel": { "enum": ["knowledge", "static", "compiled", "rendered", "compared"] },
              "capabilityIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/stableId" }
              },
              "diagnosticCodes": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^VC-AI-[A-Z0-9-]+$" }
              },
              "maxRank": { "type": "integer", "minimum": 1 }
            }
          },
          "metricIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/stableId" }
          }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    }
  }
}
