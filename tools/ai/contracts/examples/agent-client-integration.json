{
  "schemaVersion": 3,
  "profileSetId": "viewcompose-agent-clients-v3",
  "lastVerified": "2026-08-30",
  "package": {
    "name": "@viewcompose/ai-tooling",
    "version": "0.2.0",
    "transport": "stdio",
    "mcpExecutable": "viewcompose-mcp",
    "clientExecutable": "viewcompose-agent",
    "projectRootVariable": "VIEWCOMPOSE_PROJECT_ROOT",
    "sourceRootVariable": "VIEWCOMPOSE_SOURCE_ROOT"
  },
  "evidence": {
    "officialConfigurationReviewed": true,
    "deterministicProfileCount": 3,
    "sourceFreeStandaloneProfiles": 3,
    "maxPrimaryCommands": 2,
    "manualConfigurationEdits": 0,
    "transactionalProjectWrites": true,
    "protocolVersions": ["2026-07-28", "2025-11-25"],
    "vendorBinaryAutomation": false,
    "limitation": "CI validates generated configuration, transactional lifecycle behavior, exact Skill bytes, and both frozen MCP protocol handshakes; it does not authenticate or automate proprietary client binaries."
  },
  "clients": [
    {
      "id": "codex",
      "displayName": "Codex",
      "config": {
        "format": "toml",
        "projectPath": ".codex/config.toml",
        "projectBoundArguments": ["config", "--client", "codex", "--project-root", "<absolute-consumer-project-root>"],
        "sourceBoundArguments": ["config", "--client", "codex", "--project-root", "<absolute-consumer-project-root>", "--source-root", "<absolute-viewcompose-source-root>"],
        "verification": ["codex mcp list", "/mcp", "/skills"]
      },
      "skills": {"standard": "agent-skills", "projectPath": ".agents/skills", "invocationPrefix": "$"},
      "lifecycle": {
        "initArguments": ["init", "--client", "codex", "--project-root", "<absolute-consumer-project-root>"],
        "doctorArguments": ["doctor", "--client", "codex", "--project-root", "<absolute-consumer-project-root>"],
        "uninstallArguments": ["uninstall", "--client", "codex", "--project-root", "<absolute-consumer-project-root>"]
      },
      "officialDocumentation": {
        "mcp": "https://developers.openai.com/codex/mcp/",
        "skills": "https://learn.chatgpt.com/docs/build-skills"
      }
    },
    {
      "id": "claude-code",
      "displayName": "Claude Code",
      "config": {
        "format": "json",
        "projectPath": ".mcp.json",
        "projectBoundArguments": ["config", "--client", "claude-code", "--project-root", "<absolute-consumer-project-root>"],
        "sourceBoundArguments": ["config", "--client", "claude-code", "--project-root", "<absolute-consumer-project-root>", "--source-root", "<absolute-viewcompose-source-root>"],
        "verification": ["claude mcp list", "claude mcp get viewcompose", "/mcp"]
      },
      "skills": {"standard": "agent-skills", "projectPath": ".claude/skills", "invocationPrefix": "/"},
      "lifecycle": {
        "initArguments": ["init", "--client", "claude-code", "--project-root", "<absolute-consumer-project-root>"],
        "doctorArguments": ["doctor", "--client", "claude-code", "--project-root", "<absolute-consumer-project-root>"],
        "uninstallArguments": ["uninstall", "--client", "claude-code", "--project-root", "<absolute-consumer-project-root>"]
      },
      "officialDocumentation": {
        "mcp": "https://code.claude.com/docs/en/mcp",
        "skills": "https://code.claude.com/docs/en/skills"
      }
    },
    {
      "id": "cursor",
      "displayName": "Cursor",
      "config": {
        "format": "json",
        "projectPath": ".cursor/mcp.json",
        "projectBoundArguments": ["config", "--client", "cursor", "--project-root", "<absolute-consumer-project-root>"],
        "sourceBoundArguments": ["config", "--client", "cursor", "--project-root", "<absolute-consumer-project-root>", "--source-root", "<absolute-viewcompose-source-root>"],
        "verification": ["Cursor Settings > Tools & MCP", "Agent > Available Tools"]
      },
      "skills": {"standard": "agent-skills", "projectPath": ".agents/skills", "invocationPrefix": "/"},
      "lifecycle": {
        "initArguments": ["init", "--client", "cursor", "--project-root", "<absolute-consumer-project-root>"],
        "doctorArguments": ["doctor", "--client", "cursor", "--project-root", "<absolute-consumer-project-root>"],
        "uninstallArguments": ["uninstall", "--client", "cursor", "--project-root", "<absolute-consumer-project-root>"]
      },
      "officialDocumentation": {
        "mcp": "https://docs.cursor.com/context/model-context-protocol",
        "skills": "https://cursor.com/docs/skills"
      }
    }
  ]
}
