{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewcompose.com/schemas/ai/framework-compatibility-profile-v1.schema.json",
  "title": "ViewCompose AI framework compatibility profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "stability",
    "consumerSelectable",
    "knowledge",
    "artifacts",
    "harness",
    "selection"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "profileId": {"$ref": "#/$defs/sha256"},
    "stability": {"const": "released"},
    "consumerSelectable": {"const": true},
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionLane", "bundleFingerprint", "sourcePolicy"],
      "properties": {
        "versionLane": {"const": "released"},
        "bundleFingerprint": {"$ref": "#/$defs/sha256"},
        "sourcePolicy": {"const": "exact-artifact-release-revisions"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactCoordinates", "executesConsumerBuildLogic"],
      "properties": {
        "artifactCoordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^com\\.viewcompose:viewcompose-[a-z0-9-]+:[^:+\\s]+$"}
        },
        "executesConsumerBuildLogic": {"const": false}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectMatch",
        "unresolvedVersion",
        "conflictingVersion",
        "emptyProject",
        "upgradeCandidate"
      ],
      "properties": {
        "projectMatch": {"const": "exact-declared-artifact-version-subset"},
        "unresolvedVersion": {"const": "reject"},
        "conflictingVersion": {"const": "reject"},
        "emptyProject": {"const": "newest-stable-compatible-profile"},
        "upgradeCandidate": {"const": "newest-tooling-release-with-matching-profile"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "version", "sourceRevision", "knowledgeIncluded"],
      "properties": {
        "coordinate": {"type": "string", "pattern": "^com\\.viewcompose:viewcompose-[a-z0-9-]+$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "sourceRevision": {"$ref": "#/$defs/revision"},
        "knowledgeIncluded": {"type": "boolean"}
      }
    }
  }
}
