{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewcompose.com/schemas/ai/framework-profile-index-v1.schema.json",
  "title": "ViewCompose AI framework profile index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultProfileId", "profiles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "defaultProfileId": {"$ref": "#/$defs/sha256"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profileId", "profilePath", "bundlePath"],
        "properties": {
          "profileId": {"$ref": "#/$defs/sha256"},
          "profilePath": {"type": "string", "pattern": "^[a-f0-9]{64}/profile\\.json$"},
          "bundlePath": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
