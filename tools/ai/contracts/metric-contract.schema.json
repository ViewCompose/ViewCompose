{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viewcompose.com/ai/metric-contract-v1.schema.json",
  "title": "ViewCompose AI metric contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "metrics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "type": "string", "minLength": 3 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "measure", "direction", "threshold", "unit", "environment"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
          "phase": { "type": "integer", "minimum": 1, "maximum": 6 },
          "measure": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["at_least", "at_most", "exact"] },
          "threshold": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
