{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viewcompose.com/ai/project-analysis-catalog-v1.schema.json",
  "title": "ViewCompose project-analysis rule catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "applicability", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "$ref": "#/$defs/stableId" },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "versionLanes"],
      "properties": {
        "mode": { "const": "active-exact-profile" },
        "versionLanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["current-source", "released"] }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ruleCode": {
      "type": "string",
      "pattern": "^VC-AI-[A-Z0-9-]+$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion",
        "title",
        "family",
        "severity",
        "confidence",
        "suppressible",
        "mechanism",
        "suggestion",
        "evidence",
        "supportedSyntax",
        "unsupportedSyntax"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleCode" },
        "ruleVersion": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "family": {
          "enum": ["accessibility", "dependency", "symbol-resolution", "version-integrity"]
        },
        "severity": { "enum": ["info", "warning", "error"] },
        "confidence": { "const": "high" },
        "suppressible": { "type": "boolean" },
        "mechanism": { "type": "string", "minLength": 8, "maxLength": 1024 },
        "suggestion": { "type": "string", "minLength": 8, "maxLength": 1024 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 512 }
        },
        "supportedSyntax": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 512 }
        },
        "unsupportedSyntax": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 512 }
        }
      }
    }
  }
}
