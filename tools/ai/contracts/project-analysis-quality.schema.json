{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viewcompose.com/ai/project-analysis-quality-v1.schema.json",
  "title": "ViewCompose project-analysis quality snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "qualityVersion", "catalogVersion", "corpusVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "qualityVersion": { "$ref": "#/$defs/stableId" },
    "catalogVersion": { "$ref": "#/$defs/stableId" },
    "corpusVersion": { "$ref": "#/$defs/stableId" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "ruleVersion",
          "positiveOpportunities",
          "eligibleNegativeOpportunities",
          "truePositives",
          "falsePositives",
          "falseNegatives",
          "unsupportedOpportunities",
          "precision",
          "recall"
        ],
        "properties": {
          "ruleId": { "$ref": "#/$defs/ruleCode" },
          "ruleVersion": { "type": "integer", "minimum": 1 },
          "positiveOpportunities": { "type": "integer", "minimum": 25 },
          "eligibleNegativeOpportunities": { "type": "integer", "minimum": 50 },
          "truePositives": { "type": "integer", "minimum": 0 },
          "falsePositives": { "type": "integer", "minimum": 0 },
          "falseNegatives": { "type": "integer", "minimum": 0 },
          "unsupportedOpportunities": { "type": "integer", "minimum": 0 },
          "precision": { "type": "number", "minimum": 1, "maximum": 1 },
          "recall": { "type": "number", "minimum": 1, "maximum": 1 }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ruleCode": {
      "type": "string",
      "pattern": "^VC-AI-[A-Z0-9-]+$"
    }
  }
}
