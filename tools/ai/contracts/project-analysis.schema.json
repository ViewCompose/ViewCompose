{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viewcompose.com/ai/project-analysis-v1.schema.json",
  "title": "ViewCompose analyze_project analysis payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "scan", "catalog", "quality", "summary", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionLane", "identity", "match"],
      "properties": {
        "versionLane": { "enum": ["current-source", "released"] },
        "identity": { "type": "string", "minLength": 7 },
        "match": { "enum": ["exact", "empty", "different", "unresolved"] }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "bytes",
        "kotlinFiles",
        "gradleFiles",
        "xmlFiles",
        "excludedEntries",
        "unsupported"
      ],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "kotlinFiles": { "type": "integer", "minimum": 0 },
        "gradleFiles": { "type": "integer", "minimum": 0 },
        "xmlFiles": { "type": "integer", "minimum": 0 },
        "excludedEntries": { "type": "integer", "minimum": 0 },
        "unsupported": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/unsupported" }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogVersion", "rules"],
      "properties": {
        "catalogVersion": { "$ref": "#/$defs/stableId" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/ruleDescriptor" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualityVersion", "corpusVersion", "rules"],
      "properties": {
        "qualityVersion": { "$ref": "#/$defs/stableId" },
        "corpusVersion": { "$ref": "#/$defs/stableId" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/ruleQuality" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "unsuppressed", "suppressed", "unsupported"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "unsuppressed": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ruleCode": {
      "type": "string",
      "pattern": "^VC-AI-[A-Z0-9-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startLine", "startColumn"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "source"],
      "properties": {
        "kind": {
          "enum": [
            "alias",
            "custom-wrapper",
            "dynamic-dependency",
            "invalid-suppression",
            "malformed-call",
            "star-import",
            "type-resolution",
            "unreadable-file"
          ]
        },
        "reason": { "type": "string", "minLength": 3, "maxLength": 1024 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "ruleDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion",
        "title",
        "family",
        "severity",
        "confidence",
        "suppressible",
        "mechanism",
        "suggestion",
        "evidence"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleCode" },
        "ruleVersion": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 3 },
        "family": {
          "enum": ["accessibility", "dependency", "symbol-resolution", "version-integrity"]
        },
        "severity": { "enum": ["info", "warning", "error"] },
        "confidence": { "const": "high" },
        "suppressible": { "type": "boolean" },
        "mechanism": { "type": "string", "minLength": 8 },
        "suggestion": { "type": "string", "minLength": 8 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "ruleQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion",
        "positiveOpportunities",
        "eligibleNegativeOpportunities",
        "unsupportedOpportunities",
        "precision",
        "recall"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleCode" },
        "ruleVersion": { "type": "integer", "minimum": 1 },
        "positiveOpportunities": { "type": "integer", "minimum": 25 },
        "eligibleNegativeOpportunities": { "type": "integer", "minimum": 50 },
        "unsupportedOpportunities": { "type": "integer", "minimum": 0 },
        "precision": { "type": "number", "minimum": 1, "maximum": 1 },
        "recall": { "type": "number", "minimum": 1, "maximum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion",
        "severity",
        "confidence",
        "message",
        "mechanism",
        "evidence",
        "suggestion",
        "framework",
        "source",
        "suppression"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleCode" },
        "ruleVersion": { "type": "integer", "minimum": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "confidence": { "const": "high" },
        "message": { "type": "string", "minLength": 3, "maxLength": 4096 },
        "mechanism": { "type": "string", "minLength": 8, "maxLength": 1024 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 512 }
        },
        "suggestion": { "type": "string", "minLength": 8, "maxLength": 2048 },
        "artifactId": { "type": "string", "minLength": 1 },
        "capabilityId": { "type": "string", "minLength": 1 },
        "framework": {
          "type": "object",
          "additionalProperties": false,
          "required": ["versionLane", "identity"],
          "properties": {
            "versionLane": { "enum": ["current-source", "released"] },
            "identity": { "type": "string", "minLength": 7 }
          }
        },
        "source": { "$ref": "#/$defs/source" },
        "suppression": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "enum": ["none", "suppressed"] },
            "reason": { "type": "string", "minLength": 3, "maxLength": 512 },
            "directive": { "$ref": "#/$defs/source" }
          }
        }
      }
    }
  }
}
