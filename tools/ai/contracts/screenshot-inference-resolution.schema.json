{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viewcompose.com/ai/screenshot-inference-resolution-v1.schema.json",
  "title": "ViewCompose screenshot inference human resolution v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "input", "authorization", "policy", "answers"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "request"},
        "input": {"$ref": "#/$defs/inputIdentity"},
        "authorization": {"$ref": "#/$defs/authorization"},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requireAllBlockingQuestions",
            "expressions",
            "resourceGuessing",
            "executableSource",
            "allowedDecisionKinds"
          ],
          "properties": {
            "requireAllBlockingQuestions": {"const": true},
            "expressions": {"const": "forbidden"},
            "resourceGuessing": {"const": "forbidden"},
            "executableSource": {"const": false},
            "allowedDecisionKinds": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {"enum": ["accessibility-review", "set-events", "set-fields"]}
            }
          }
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/answer"}
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "status",
        "requestFingerprint",
        "input",
        "authorization",
        "designIr",
        "designIrFingerprint",
        "resolutionRecords",
        "remainingQuestionIds",
        "summary",
        "diagnostics",
        "resultFingerprint"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "result"},
        "status": {"enum": ["resolved", "incomplete"]},
        "requestFingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/inputIdentity"},
        "authorization": {"$ref": "#/$defs/authorization"},
        "designIr": {"type": "object"},
        "designIrFingerprint": {"$ref": "#/$defs/sha256"},
        "resolutionRecords": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/resolutionRecord"}
        },
        "remainingQuestionIds": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answeredQuestions",
            "remainingQuestions",
            "resolvedUnsupportedSemantics",
            "remainingUnsupportedSemantics",
            "placeholderBindings",
            "codeGenerationAllowed"
          ],
          "properties": {
            "answeredQuestions": {"type": "integer", "minimum": 0, "maximum": 1000},
            "remainingQuestions": {"type": "integer", "minimum": 0, "maximum": 1000},
            "resolvedUnsupportedSemantics": {"type": "integer", "minimum": 0, "maximum": 1000},
            "remainingUnsupportedSemantics": {"type": "integer", "minimum": 0, "maximum": 1000},
            "placeholderBindings": {"type": "integer", "minimum": 0, "maximum": 1000},
            "codeGenerationAllowed": {"type": "boolean"}
          }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/diagnostic"}
        },
        "resultFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "answer": {
      "oneOf": [
        {"$ref": "#/$defs/contentAnswer"},
        {"$ref": "#/$defs/behaviorAnswer"},
        {"$ref": "#/$defs/accessibilityAnswer"}
      ]
    },
    "contentAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId", "nodeId", "sourceRegion", "category", "requiredAction", "decision"
      ],
      "properties": {
        "questionId": {"$ref": "#/$defs/stableId"},
        "nodeId": {"$ref": "#/$defs/stableId"},
        "sourceRegion": {"$ref": "#/$defs/region"},
        "category": {"const": "content"},
        "requiredAction": {"const": "human-answer"},
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fields"],
          "properties": {
            "kind": {"const": "set-fields"},
            "fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"$ref": "#/$defs/fieldDecision"}
            }
          }
        }
      }
    },
    "behaviorAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId", "nodeId", "sourceRegion", "category", "requiredAction", "decision"
      ],
      "properties": {
        "questionId": {"$ref": "#/$defs/stableId"},
        "nodeId": {"$ref": "#/$defs/stableId"},
        "sourceRegion": {"$ref": "#/$defs/region"},
        "category": {"const": "behavior"},
        "requiredAction": {"const": "source-inspection"},
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "events"],
          "properties": {
            "kind": {"const": "set-events"},
            "events": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {"$ref": "#/$defs/eventDecision"}
            }
          }
        }
      }
    },
    "accessibilityAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "sourceRegion", "category", "requiredAction", "decision"],
      "properties": {
        "questionId": {"$ref": "#/$defs/stableId"},
        "sourceRegion": {"$ref": "#/$defs/region"},
        "category": {"const": "accessibility"},
        "requiredAction": {"const": "human-answer"},
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodes"],
          "properties": {
            "kind": {"const": "accessibility-review"},
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {"$ref": "#/$defs/accessibilityNode"}
            }
          }
        }
      }
    },
    "fieldDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "name", "value"],
      "properties": {
        "collection": {"enum": ["properties", "state"]},
        "name": {"$ref": "#/$defs/stableId"},
        "value": {"$ref": "#/$defs/safeValue"}
      }
    },
    "safeValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "literal"},
            "value": {"type": "string", "maxLength": 4096}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "type", "value"],
          "properties": {
            "kind": {"const": "enum"},
            "type": {"const": "android-input-type"},
            "value": {"enum": ["number", "text", "textEmailAddress", "textPassword"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "status"],
          "properties": {
            "kind": {"const": "binding"},
            "name": {"$ref": "#/$defs/stableId"},
            "status": {"const": "resolved"}
          }
        }
      ]
    },
    "eventDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binding", "status"],
      "properties": {
        "kind": {"enum": ["click", "focus-change", "keyboard-action"]},
        "binding": {"$ref": "#/$defs/stableId"},
        "status": {"const": "resolved"}
      }
    },
    "accessibilityNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "role", "labelSource", "traversalIndex", "decorative"],
      "properties": {
        "nodeId": {"$ref": "#/$defs/stableId"},
        "role": {"enum": ["button", "image", "none", "text-field"]},
        "labelSource": {"enum": ["none", "visible-text", "field-label"]},
        "traversalIndex": {"type": "integer", "minimum": 0, "maximum": 999},
        "decorative": {"type": "boolean"}
      }
    },
    "resolutionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "category",
        "requiredAction",
        "decisionKind",
        "targetNodeIds",
        "resolvedUnsupportedCodes",
        "reviewReceipt"
      ],
      "properties": {
        "questionId": {"$ref": "#/$defs/stableId"},
        "category": {"enum": ["accessibility", "behavior", "content"]},
        "requiredAction": {"enum": ["human-answer", "source-inspection"]},
        "decisionKind": {"enum": ["accessibility-review", "set-events", "set-fields"]},
        "targetNodeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "resolvedUnsupportedCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"pattern": "^VC-AI-[A-Z0-9-]+$", "type": "string"}
        },
        "reviewReceipt": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationFingerprint", "inferenceResultFingerprint", "designIrFingerprint"],
      "properties": {
        "validationFingerprint": {"$ref": "#/$defs/sha256"},
        "inferenceResultFingerprint": {"$ref": "#/$defs/sha256"},
        "designIrFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reviewerId",
        "reviewReceipt",
        "approvedPurpose",
        "approvedValidationFingerprint",
        "sourceInspectionCompleted",
        "providerExecution",
        "networkAccess",
        "logs"
      ],
      "properties": {
        "mode": {"const": "human-resolution"},
        "reviewerId": {"$ref": "#/$defs/stableId"},
        "reviewReceipt": {"$ref": "#/$defs/sha256"},
        "approvedPurpose": {"const": "resolve-screenshot-inference"},
        "approvedValidationFingerprint": {"$ref": "#/$defs/sha256"},
        "sourceInspectionCompleted": {"const": true},
        "providerExecution": {"const": false},
        "networkAccess": {"const": false},
        "logs": {"const": "metadata-only"}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0, "maximum": 4095},
        "y": {"type": "integer", "minimum": 0, "maximum": 4095},
        "width": {"type": "integer", "minimum": 1, "maximum": 4096},
        "height": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "nextAction"],
      "properties": {
        "code": {"pattern": "^VC-AI-[A-Z0-9-]+$", "type": "string"},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "nextAction": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
