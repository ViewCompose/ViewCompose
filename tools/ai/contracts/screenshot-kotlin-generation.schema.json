{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viewcompose.com/ai/screenshot-kotlin-generation-v1.schema.json",
  "title": "ViewCompose screenshot Kotlin generation v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/report"}
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "input", "mode", "policy"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "request"},
        "input": {"$ref": "#/$defs/inputIdentity"},
        "mode": {"enum": ["generate", "compile"]},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requireResolvedStatus",
            "requireCodeGenerationAllowed",
            "expressions",
            "resourceGuessing",
            "callbackSource",
            "accessibilityTraversal"
          ],
          "properties": {
            "requireResolvedStatus": {"const": true},
            "requireCodeGenerationAllowed": {"const": true},
            "expressions": {"const": "forbidden"},
            "resourceGuessing": {"const": "forbidden"},
            "callbackSource": {"const": "forbidden"},
            "accessibilityTraversal": {"const": "structural-order-with-report"}
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestFingerprint",
        "input",
        "target",
        "bindings",
        "accessibility",
        "callSiteReview",
        "verification",
        "kotlinFingerprint",
        "reportFingerprint"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "report"},
        "requestFingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/inputIdentity"},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "packageName", "functionName", "artifactIds", "capabilityIds"],
          "properties": {
            "language": {"const": "kotlin"},
            "packageName": {"const": "generated.viewcompose"},
            "functionName": {"$ref": "#/$defs/kotlinIdentifier"},
            "artifactIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/stableId"}
            },
            "capabilityIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/stableId"}
            }
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["states", "events"],
          "properties": {
            "states": {
              "type": "array",
              "maxItems": 1000,
              "items": {"$ref": "#/$defs/stateBinding"}
            },
            "events": {
              "type": "array",
              "maxItems": 1000,
              "items": {"$ref": "#/$defs/eventBinding"}
            }
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewReceipt", "nodes", "traversal"],
          "properties": {
            "reviewReceipt": {"$ref": "#/$defs/sha256"},
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {"$ref": "#/$defs/accessibilityNode"}
            },
            "traversal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "explicitModifier", "orderedNodeIds", "reviewRequired"],
              "properties": {
                "mode": {"const": "hierarchy-order"},
                "explicitModifier": {"const": false},
                "orderedNodeIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/stableId"}
                },
                "reviewRequired": {"const": true}
              }
            }
          }
        },
        "callSiteReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "items"],
          "properties": {
            "required": {"const": true},
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {"type": "string", "minLength": 1, "maxLength": 1024}
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "compilation", "rendering", "visualComparison"],
          "properties": {
            "generation": {"const": "deterministic"},
            "compilation": {"enum": ["required", "passed"]},
            "rendering": {"const": "not-claimed"},
            "visualComparison": {"const": "not-claimed"}
          }
        },
        "kotlinFingerprint": {"$ref": "#/$defs/sha256"},
        "reportFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolutionResultFingerprint", "resolvedDesignIrFingerprint"],
      "properties": {
        "resolutionResultFingerprint": {"$ref": "#/$defs/sha256"},
        "resolvedDesignIrFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "stateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "parameter", "type", "status", "nodeIds"],
      "properties": {
        "source": {"$ref": "#/$defs/stableId"},
        "parameter": {"$ref": "#/$defs/kotlinIdentifier"},
        "type": {"const": "TextFieldState"},
        "status": {"const": "resolved"},
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        }
      }
    },
    "eventBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "parameter", "event", "type", "status", "nodeIds"],
      "properties": {
        "source": {"$ref": "#/$defs/stableId"},
        "parameter": {"$ref": "#/$defs/kotlinIdentifier"},
        "event": {"enum": ["click", "focus-change", "keyboard-action"]},
        "type": {"enum": ["() -> Unit", "(Boolean) -> Unit", "(TextFieldImeAction) -> Boolean"]},
        "status": {"const": "resolved"},
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        }
      }
    },
    "accessibilityNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "role",
        "labelSource",
        "traversalIndex",
        "decorative",
        "emission"
      ],
      "properties": {
        "nodeId": {"$ref": "#/$defs/stableId"},
        "role": {"enum": ["button", "none", "text-field"]},
        "labelSource": {"enum": ["field-label", "none", "visible-text"]},
        "traversalIndex": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "decorative": {"type": "boolean"},
        "emission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "label", "traversal", "decorative"],
          "properties": {
            "role": {"enum": ["component-default", "not-applicable"]},
            "label": {"enum": ["component-placeholder", "none", "visible-text"]},
            "traversal": {"const": "hierarchy-order"},
            "decorative": {"enum": ["default-visible", "hidden"]}
          }
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "kotlinIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
