    "unsupportedNewerMajor": "reject",
    "implicitDowngrade": false,
    "unknownFieldPolicy": "schema-defined"
  },
  "versionLanes": [
    {
      "id": "current-source",
      "identity": "exact-git-revision",
      "movableAlias": false
