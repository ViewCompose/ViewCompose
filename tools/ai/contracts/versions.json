{
  "schemaVersion": 1,
  "contracts": {
    "knowledgeBundleManifest": 1,
    "toolEnvelope": 1,
    "designIr": 1,
    "xmlProjectContext": 1,
    "xmlLayoutDependencies": 1,
    "generatedPreviewRequest": 1,
    "layoutComparison": 1,
    "screenshotPreprocessing": 1,
    "screenshotDesignInference": 1,
    "screenshotInferenceResolution": 1,
    "screenshotKotlinGeneration": 1,
    "screenshotPixelComparison": 1,
    "screenshotPixelLocalization": 1,
    "screenshotRepair": 2,
