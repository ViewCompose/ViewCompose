  "reservedCapabilities": [
    {
      "id": "tooling.ai-knowledge",
      "activationPhase": 1,
      "initialQLevel": "Q3",
      "contractFields": ["version", "source-lineage", "freshness", "determinism", "dependencies", "limits"]
    },
    {
      "id": "tooling.ai-validation",
      "activationPhase": 2,
      "initialQLevel": "Q3",
      "contractFields": ["version", "threading", "execution", "security", "diagnostics", "limits", "performance"]
    },
    {
      "id": "tooling.ai-protocol",
      "activationPhase": 3,
      "initialQLevel": "Q3",
      "contractFields": ["version", "transport", "compatibility", "cancellation", "security", "limits", "errors"]
    },
    {
      "id": "tooling.ai-migration",
      "activationPhase": 4,
      "initialQLevel": "Q3",
      "contractFields": ["source-version", "target-version", "preservation", "unsupported-semantics", "provenance", "verification"]
    },
    {
      "id": "tooling.ai-visual-generation",
      "activationPhase": 5,
      "initialQLevel": "Q2",
      "contractFields": ["provider", "privacy", "assets", "configuration", "comparison", "repair", "limits"]
    }
  ]
