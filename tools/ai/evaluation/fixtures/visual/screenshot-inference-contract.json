      "consentReceiptRequired": true,
      "consentBoundToExactInput": true,
      "approvedPurpose": "screenshot-to-design-ir",
      "retentionReviewRequired": true,
      "rawRequestPersistence": false,
      "rawResponsePersistence": false,
      "immutableModelIdentityRequired": true
    }
  },
  "result": {
    "humanAndProviderProducersSeparated": true,
    "providerRequestFingerprintRequired": true,
    "providerResponseFingerprintRequired": true,
    "incompleteWhenBlockingQuestionsRemain": true,
    "allUnresolvedQuestionsForbidDefaults": true,
    "allUnsupportedSemanticsBlocked": true
