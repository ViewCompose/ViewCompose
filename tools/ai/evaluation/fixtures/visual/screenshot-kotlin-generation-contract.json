{
  "schemaVersion": 1,
  "contractId": "viewcompose-screenshot-kotlin-generation-v1",
  "requiresContracts": [
    "design-ir-v1",
    "screenshot-inference-resolution-v1",
    "screenshot-kotlin-generation-v1"
  ],
  "activation": {
    "tool": "generate_screenshot_viewcompose",
    "status": "implemented",
    "publicTool": true,
    "implementation": true,
    "evidence": "compiled-golden"
  },
  "lineage": {
    "acceptedInput": "resolved-screenshot-inference-only",
    "resolutionStatus": "resolved",
    "codeGenerationAllowed": true,
    "resolutionResultFingerprint": "exact",
    "resolvedDesignIrFingerprint": "exact",
    "requestFingerprint": "sha256-canonical-json",
    "kotlinFingerprint": "sha256-source-bytes",
    "reportFingerprint": "sha256-canonical-json-without-reportFingerprint"
  },
  "mapping": {
    "sourceKind": "screenshot",
    "rootCount": 1,
    "supportedNodeKinds": ["button", "column", "text", "text-field"],
    "containerOrientation": {
      "column": {"type": "axis", "value": "vertical"}
    },
    "properties": {
      "text.text": "Text.text",
      "button.text": "Button.text",
      "text-field.hint": "TextField.placeholder",
      "text-field.inputType.text": "TextFieldInputProfile.Text",
      "text-field.inputType.textEmailAddress": "TextFieldInputProfile.Email",
      "text-field.inputType.textPassword": "TextFieldInputProfile.Password",
      "text-field.inputType.number": "TextFieldInputProfile.Number"
    },
    "state": {
      "text-field.text": {
        "parameterType": "TextFieldState",
        "ownership": "caller"
      }
    },
    "events": {
      "button.click": {
        "argument": "onClick",
        "parameterType": "() -> Unit"
      },
      "text-field.focus-change": {
        "argument": "onFocusChange",
        "parameterType": "(Boolean) -> Unit"
      },
      "text-field.keyboard-action": {
        "argument": "onKeyboardAction",
        "parameterType": "(TextFieldImeAction) -> Boolean"
      }
    },
    "key": "node-id",
    "expressions": false,
    "resources": false,
    "callbackSource": false,
    "placeholderBindings": false
  },
  "accessibility": {
    "reviewReceiptRequired": true,
    "allNodesReported": true,
    "role": {
      "button": "component-default",
      "text-field": "component-default",
      "none": "not-applicable"
    },
    "labelSource": {
      "visible-text": "visible-text",
      "field-label": "component-placeholder",
      "none": "none"
    },
    "traversal": {
      "resolvedField": "traversalIndex",
      "publicModifierAvailable": false,
      "emission": "hierarchy-order",
      "exactAscendingOrderRequired": true,
      "callSiteReviewRequired": true
    },
    "decorative": {
      "false": "default-visible",
      "true": "unsupported-without-image-subset"
    }
  },
  "compiler": {
    "required": true,
    "lane": "jdk21-kotlin-2.3.10-source",
    "artifactIds": ["viewcompose-ui-foundation"],
    "capabilityIds": ["foundation.components"],
    "evidenceLevel": "compiled",
    "projectBuildExecution": false,
    "networkAccess": false
  },
  "claims": {
    "deterministicGeneration": true,
    "goldenCompilation": true,
    "runtimeRendering": false,
    "visualParity": false
  },
  "limits": {
    "maxNodes": 1000,
    "maxBindings": 1000,
    "maxGeneratedBytes": 262144
  },
  "diagnosticCodes": [
    "VC-AI-SCREENSHOT-GENERATION-CANCELLED",
    "VC-AI-SCREENSHOT-GENERATION-INPUT-INVALID",
    "VC-AI-SCREENSHOT-GENERATION-LINEAGE-MISMATCH",
    "VC-AI-SCREENSHOT-GENERATION-NOT-ELIGIBLE",
    "VC-AI-SCREENSHOT-GENERATION-UNSUPPORTED"
  ],
  "supportedFixtures": [
    {
      "resolutionResult": "screenshot-resolution/wireframe.result.json",
      "request": "screenshot-generation/wireframe.request.json",
      "goldenKotlin": "screenshot-generation/wireframe.generated.kt",
