      "expectedRequestFingerprint": "176fd47687381494a4cb9331d5ae682d7a52b4483641ac3930621afbf29c4551",
      "expectedKotlinFingerprint": "5812c3ccbd0a6f30a0cc4c3ff4e71453006745d5dd76e63e153b2501131252e9",
      "expectedReportFingerprint": "51c09b75e1a8bec953191e50388795c61fff6c45841de1f7832e050d2824752d",
