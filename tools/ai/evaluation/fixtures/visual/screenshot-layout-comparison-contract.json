{
  "schemaVersion": 1,
  "contractId": "viewcompose-screenshot-layout-comparison-v1",
  "requiresContracts": [
    "design-ir-v1",
    "viewcompose-screenshot-generated-preview-v1",
    "layout-comparison-v1"
  ],
  "activation": {
    "tool": "generate_screenshot_viewcompose",
    "status": "implemented",
    "publicCompareMode": true,
    "implementation": true,
    "successEvidence": "compared",
    "failureEvidence": "rendered"
  },
  "input": {
    "designIr": "the exact resolved screenshot Design IR supplied to Kotlin generation",
    "previewRequest": "the exact content-addressed screenshot generated Preview request",
    "renderTree": "the contained artifact from the accepted screenshot generated Preview result",
    "callerSuppliedDesignIr": false,
    "callerSuppliedRenderTree": false,
    "callerSuppliedPolicy": false
  },
  "integrity": {
    "resolvedDesignIrFingerprint": "must equal the accepted screenshot resolution result",
    "previewRequestFingerprint": "must equal screenshot generated Preview evidence",
    "renderTreeFingerprint": "reopen and verify the exact declared artifact before comparison",
    "outputFingerprint": "must equal screenshot generated Preview evidence",
    "followSymbolicLinks": false,
    "absolutePathsInPublicResult": false,
    "networkAccess": false,
    "executeInspectedProjectBuildLogic": false
  },
  "identity": {
    "designNodeIdToKey": "strip one leading id: prefix; preserve every other Design IR id exactly",
    "keyMultiplicity": "exactly one virtual node",
    "nativeNodeIdentity": "exact virtual nodeId",
    "extraAuthoredKeys": "fail comparison",
    "frameworkRootWithoutNodeId": "ignored",
    "syntheticNodes": "fail comparison unless allowlisted by semanticHostWrappers"
  },
  "semanticHostWrappers": [
    {
      "designKind": "text-field",
      "identityRenderKind": "column",
      "semanticRenderKind": "text-field",
      "maxDepth": 1,
      "requirements": [
        "exactly one child",
        "child key is absent",
        "identity and semantic host bounds are equal"
      ]
    }
  ],
  "claims": {
    "checked": [
      "exact authored node identity",
      "declared parent and child order",
      "mapped component kind",
      "declared semantic role",
      "visibility",
      "declared title and button visible text",
      "parent containment",
      "column sibling order",
      "allowlisted text-field wrapper bounds"
    ],
    "notClaimed": [
      "text-field placeholder because render-tree properties omit it",
      "source screenshot region alignment or exact source geometry",
      "pixel or perceptual similarity",
      "style, color, typography, or draw order",
      "accessibility traversal or complete accessibility behavior",
      "state mutation, event execution, focus, or interaction behavior",
      "multiple device configurations"
    ]
  },
  "policy": {
    "nodeIdentity": "exact-normalized-key",
    "semanticHost": "identity-or-allowlisted-single-child-wrapper",
    "resourceValues": "exact-preview-binding-source",
    "dpRounding": "nearest-integer-px",
    "geometryTolerancePx": 0,
    "hiddenGeometry": "not-applicable-only-for-gone",
    "allRequiredChecksMustPass": true,
    "oneAggregateScore": false
  },
  "limits": {
    "maxDesignNodes": 1000,
    "maxVirtualNodes": 2000,
    "maxNativeNodes": 4000,
    "maxDepth": 64,
    "maxRenderTreeBytes": 8388608,
    "maxChecksPerNode": 128,
    "maxFindings": 1000,
    "maxWrapperDepth": 1
  },
  "diagnosticCodes": [
    "VC-AI-COMPARE-INPUT-INVALID",
    "VC-AI-COMPARE-DESIGN-IR-MISMATCH",
    "VC-AI-COMPARE-RENDER-EVIDENCE-MISMATCH",
    "VC-AI-COMPARE-RENDER-TREE-INVALID",
    "VC-AI-COMPARE-NODE-MISSING",
    "VC-AI-COMPARE-NODE-AMBIGUOUS",
    "VC-AI-COMPARE-KIND-MISMATCH",
    "VC-AI-COMPARE-STRUCTURE-MISMATCH",
    "VC-AI-COMPARE-SEMANTIC-MISMATCH",
    "VC-AI-COMPARE-GEOMETRY-MISMATCH",
    "VC-AI-COMPARE-LIMIT"
  ],
