{
  "schemaVersion": 1,
  "contractId": "viewcompose-screenshot-pixel-comparison-v1",
  "requiresContracts": [
    "screenshot-preprocessing-v1",
    "viewcompose-screenshot-layout-comparison-v1",
    "screenshot-pixel-comparison-v1",
    "screenshot-pixel-localization-v1"
  ],
  "activation": {
    "tool": "generate_screenshot_viewcompose",
    "status": "implemented",
    "publicPixelCompareMode": true,
    "implementation": true,
    "localizationStatus": "implemented",
    "successEvidence": "compared",
    "failureEvidence": "rendered"
  },
  "input": {
    "referenceRequest": "the exact reviewed screenshot preprocessing request",
    "referenceResult": "the exact canonical screenshot preprocessing result",
    "semanticComparison": "the accepted semantic and structural comparison result",
    "renderedPng": "the contained PNG artifact from the same accepted Preview evidence",
    "callerSuppliedPolicy": false,
    "callerSuppliedArtifactPath": false
  },
  "eligibility": {
    "preprocessingLineage": "request and result canonical fingerprints must match",
    "referenceIntegrity": "embedded input and canonical output PNG identities must verify",
    "semanticEvidence": "passed exact semantic comparison from the same render is required",
    "redactions": "none",
    "dimensions": "exact output and render dimensions",
    "configuration": [
      "density",
      "fontScale",
      "localeTag",
      "layoutDirection",
      "colorSpace",
      "alphaMode",
      "orientation",
      "systemBars",
      "crop"
    ],
    "crop": "full rendered viewport",
    "dimensionTolerancePx": 0
  },
  "policy": {
    "colorSpace": "sRGB",
    "alphaMode": "straight",
    "coordinateSpace": "exact-cropped-viewport",
    "redactions": "none",
    "semanticEvidenceRequired": true,
    "dimensionTolerancePx": 0,
    "channelTolerance": 0,
    "aggregateScore": false
  },
  "localizationPolicy": {
    "ownership": "deepest-containing-design-node",
    "bounds": "left-top-inclusive-right-bottom-exclusive",
    "tieBreak": "deepest-path-then-design-node-id",
    "unassigned": "retained-separately",
    "aggregateScore": false
  },
  "metrics": [
    "totalPixels",
    "comparedPixels",
    "mismatchedPixels",
    "exactPixelRatio",
    "meanAbsoluteErrorRgba",
    "rootMeanSquareErrorRgba",
    "maxChannelDelta"
  ],
  "claims": {
    "checked": [
      "exact decoded RGBA equality after strict eligibility checks",
      "per-channel absolute and squared error over the full viewport",
      "content-addressed reference and render PNG identity",
      "bounded mismatch bounds and deepest-node attribution without patch inference"
    ],
    "notClaimed": [
      "perceptual similarity",
      "cross-device, cross-renderer, or cross-font equivalence",
      "animation, interaction, state transition, or motion behavior",
      "design intent or aesthetic quality",
      "automatic source repair",
      "repair values inferred from mismatch location",
      "pixel parity for redacted or configuration-mismatched references"
    ]
  },
  "limits": {
    "maxCompressedBytesPerPng": 1310720,
    "maxDecodedBytesPerPng": 16777216,
    "maxDimensionPx": 4096,
    "maxPixels": 4194304,
    "maxPngChunks": 128,
    "maxFindings": 1000
  },
  "diagnosticCodes": [
    "VC-AI-PIXEL-INPUT-INVALID",
    "VC-AI-PIXEL-REFERENCE-INTEGRITY-MISMATCH",
    "VC-AI-PIXEL-PREPROCESSING-MISMATCH",
