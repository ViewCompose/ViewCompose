{
  "schemaVersion": 1,
  "contractId": "viewcompose-screenshot-preprocessing-v1",
  "requiresContracts": [
    "screenshot-preprocessing-v1"
  ],
  "activation": {
    "tool": "prepare_screenshot",
    "status": "contract-frozen",
    "evidence": "static"
  },
  "input": {
    "embeddedPngOnly": true,
    "pathInputAllowed": false,
    "urlInputAllowed": false,
    "uriInputAllowed": false,
    "credentialsAllowed": false,
    "acceptedBitDepths": [8],
    "acceptedColorTypes": [6],
    "acceptedFilterTypes": [0, 1, 2, 3, 4],
    "acceptedInterlaceMethods": [0]
  },
  "interpretation": {
    "callerDeclaresDensity": true,
    "callerDeclaresFontScale": true,
    "callerDeclaresLocale": true,
    "callerDeclaresLayoutDirection": true,
    "callerDeclaresColorSpace": true,
    "callerDeclaresAlphaMode": true,
    "callerDeclaresOrientation": true,
    "systemBars": "declaration-only",
    "automaticSystemBarInference": false
  },
  "processing": {
    "order": ["verify", "decode", "crop", "redact", "encode"],
    "cropCoordinates": "source-image-pixels",
    "redactionCoordinates": "cropped-output-pixels",
    "redactionReplacement": "#000000ff",
    "redactionOverlap": "request-order-idempotent",
    "resize": "none"
  },
  "output": {
    "mediaType": "image/png",
    "canonicalChunks": ["IHDR", "IDAT", "IEND"],
    "stripAncillaryChunks": true,
    "filterType": 0,
    "zlibLevel": 9,
    "colorSpace": "sRGB",
    "alphaMode": "straight"
  },
  "privacy": {
    "reviewRequired": true,
    "providerTransfer": false,
    "networkAccess": false,
    "inputPersistence": false,
    "outputPersistence": false,
    "logs": "metadata-only",
    "redactions": "explicit-rectangles-only",
    "automaticSensitiveContentDetection": false
  },
  "integrity": {
    "verifyCanonicalBase64": true,
    "verifyDeclaredBytes": true,
    "verifySha256": true,
    "verifyDimensions": true,
    "verifyChunkCrc": true,
    "verifyDecodedByteCount": true,
    "outputFingerprint": "sha256-canonical-json-without-outputFingerprint"
  },
  "limits": {
    "maxCompressedBytes": 8388608,
    "maxDimensionPx": 4096,
    "maxDecodedBytes": 67108864,
    "maxPngChunks": 256,
    "maxRedactions": 64,
    "maxOutputBytes": 8388608
  },
  "diagnosticCodes": [
    "VC-AI-SCREENSHOT-INPUT-INVALID",
    "VC-AI-SCREENSHOT-PATH-DENIED",
    "VC-AI-SCREENSHOT-PROVIDER-TRANSFER-DENIED",
    "VC-AI-SCREENSHOT-PNG-INTEGRITY-INVALID",
    "VC-AI-SCREENSHOT-PNG-UNSUPPORTED",
    "VC-AI-SCREENSHOT-CROP-INVALID",
    "VC-AI-SCREENSHOT-REDACTION-INVALID",
    "VC-AI-SCREENSHOT-LIMIT"
  ],
  "supportedFixtures": [
    {
      "request": "screenshot/privacy-grid.request.json",
      "result": "screenshot/privacy-grid.result.json",
      "status": "contract-frozen",
      "expectedRequestFingerprint": "0965268f988e8cbb0aded1f5e15a30ab2a5e9a2858ff36cc434c62cfbff53ecd",
      "expectedInputSha256": "ff96bfc58337301e15ff1515d39a2653a855a46ef74e50f8884889cd28f21cc0",
      "expectedOutputSha256": "201c08259fb2891c57c3f85e0f9e1157ad9df9ae8303c4f8d679735cf2850b99",
      "expectedOutputFingerprint": "3cfb37a6ea282853bccfbdd3b23e26dacee875f3a29f179e4564bf5f3df96808",
      "expectedInputSize": [4, 4],
      "expectedOutputSize": [4, 4],
      "expectedRedactions": 1
    }
  ],
  "unsupportedFixtures": [
    {
      "request": "screenshot/path-input.request.json",
      "schemaValid": false,
      "diagnosticCodes": ["VC-AI-SCREENSHOT-PATH-DENIED"]
    },
    {
      "request": "screenshot/provider-transfer.request.json",
      "schemaValid": false,
      "diagnosticCodes": ["VC-AI-SCREENSHOT-PROVIDER-TRANSFER-DENIED"]
    }
  ]
}
