{
  "schemaVersion": 1,
  "contractId": "viewcompose-screenshot-repair-host-grant-v1",
  "requiresContracts": [
    "screenshot-repair-authorization-v1",
    "screenshot-repair-host-grant-v1"
  ],
  "activation": {
    "tool": "generate_screenshot_viewcompose",
    "status": "contract-frozen",
    "publicRepairMode": false,
    "implementation": false,
    "executionAuthorized": false
  },
  "boundary": {
    "request": "exact validated authorization, evidence, proposal, change, reference, Design IR, and baseline source identities",
    "decision": "trusted host callback only; serialized caller decisions have no authority",
    "authentication": "host authenticates both reviewer identities and purpose-bound review receipts",
    "revocation": "host checks both receipts immediately before reservation",
    "consumption": "host durably reserves exactly one application attempt atomically",
    "failure": "a reserved attempt is terminal even when patch application fails",
    "credentials": "out-of-band host transport only",
    "providerCalls": false,
    "toolNetworkAccess": false,
    "unattendedExecution": false,
    "logs": "fingerprints-only"
  },
  "policy": {
    "maxAttempts": 1,
    "authorizationReuse": false,
    "retryAfterReservationFailure": false,
    "decisionTransport": "trusted-host-callback-only",
    "callerSuppliedDecision": false,
    "hostState": "durable",
    "publicActivation": false
  },
  "diagnosticCodes": [
    "VC-AI-REPAIR-HOST-GRANT-INPUT-INVALID",
    "VC-AI-REPAIR-HOST-GRANT-INTEGRITY-MISMATCH",
    "VC-AI-REPAIR-HOST-GRANT-LINEAGE-MISMATCH",
    "VC-AI-REPAIR-HOST-GRANT-AUTHENTICATION-FAILED",
    "VC-AI-REPAIR-HOST-GRANT-REVOKED",
    "VC-AI-REPAIR-HOST-GRANT-ALREADY-CONSUMED",
    "VC-AI-REPAIR-HOST-GRANT-POLICY-DENIED",
    "VC-AI-REPAIR-HOST-GRANT-CANCELLED"
  ],
  "claims": {
    "checked": [
      "grant request binds the exact structurally validated authorization and repair lineage",
      "granted decision binds authenticated principals and review receipts to the original reviewers",
      "both review receipts are active immediately before one durable atomic reservation",
      "one reservation permits one exact attended attempt and cannot be retried or reused"
    ],
    "notClaimed": [
      "local verification of host identity, authentication receipts, or revocation checks",
      "authority for a decision loaded from a file, stdin, CLI argument, MCP argument, or network payload",
      "an implemented durable host store, callback transport, patch executor, or recovery workflow",
      "public or unattended screenshot repair execution"
    ]
  },
  "supportedFixtures": [
    {
      "id": "authenticated-active-atomic-single-use-grant",
