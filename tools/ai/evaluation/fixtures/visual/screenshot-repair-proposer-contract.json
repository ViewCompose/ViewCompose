{
  "schemaVersion": 1,
  "contractId": "viewcompose-screenshot-repair-proposer-v1",
  "requiresContracts": [
    "design-ir-v1",
    "screenshot-pixel-localization-v1",
    "screenshot-repair-v2",
    "screenshot-repair-candidate-evidence-v1",
    "screenshot-repair-proposal-v1"
  ],
  "activation": {
    "tool": "generate_screenshot_viewcompose",
    "status": "contract-frozen",
    "publicRepairMode": false,
    "implementation": false,
    "mode": "single-property-regression-rollback"
  },
  "input": {
    "baselineEvidence": "one complete schema-valid previously evaluated candidate record",
    "candidateEvidence": "one complete schema-valid current candidate record",
    "callerSuppliedPatch": false,
    "callerSuppliedTargetValue": false,
    "pixelOrVisionInferredValue": false
  },
  "eligibility": {
    "sharedLineage": [
      "baseResolutionResultFingerprint",
      "inputDesignIrFingerprint"
    ],
    "evidenceIntegrity": "both evidence fingerprints and all nested fingerprints reproduce",
    "candidateGate": "safety through structure passed and exact-pixels failed",
    "baselineGate": "same exact-pixel denominator with strictly fewer mismatched pixels and no larger maximum channel delta",
    "difference": "exactly one existing properties field has a different non-expression typed value",
    "localization": "the changed Design IR node has at least one attributed mismatched pixel",
    "targetValue": "the exact typed value retained by baseline Design IR",
    "revalidation": "every emitted patch must still pass the existing patch applier and six-gate evaluator"
  },
  "policy": {
    "maxOperations": 1,
    "eligibleOperations": ["replace-field"],
    "eligibleCollections": ["properties"],
    "maxDesignNodes": 1000,
    "maxEvidenceBytes": 16777216,
    "valueInference": false,
    "providerCalls": false,
    "networkAccess": false,
    "executeInspectedProjectBuildLogic": false,
    "aggregateScore": false
  },
  "diagnosticCodes": [
    "VC-AI-REPAIR-PROPOSAL-NONE",
    "VC-AI-REPAIR-PROPOSAL-INPUT-INVALID",
    "VC-AI-REPAIR-PROPOSAL-CANCELLED"
  ],
  "claims": {
    "checked": [
      "rollback target values come only from an integrity-verified better baseline",
      "one changed properties field on one pixel-attributed node",
      "same exact-pixel denominator and strict mismatch improvement",
      "no inferred value from pixel location, OCR, vision, or layout findings",
      "typed patch remains subject to the complete six-gate evaluator"
    ],
    "notClaimed": [
      "repair of a novel screenshot mismatch without a better baseline",
      "text, color, dimension, modifier, resource, structure, behavior, or accessibility inference",
      "causality between an attributed node and every changed pixel",
      "public automatic repair mode",
      "perceptual similarity or arbitrary source repair"
    ]
  },
  "supportedFixtures": [
    {
      "id": "single-localized-property-regression",
      "baselineEvidenceFingerprint": "ce8555c98b3febf00cdd23978da5c5af685efcddb17c0f2110b229ec26a7605a",
      "candidateEvidenceFingerprint": "e0bd2617d05017bf9fa864139ecc03535b35a3b8b7bbbf491c28884be0c60068",
