        "changeFingerprint": "7a126542aa952fc46f0859d530d72c8fd7e93d268c696e5b514e4cc2c3f9f945"
      },
      "expectedProposalFingerprint": "47bffb223b1503cb603f77840ea46ec9ae375bc7efa5637c5a3635adbcecce68"
    }
  ],
  "noEligibleFixtures": [
    {"mutation": "candidate-already-exact", "expectedReason": "candidate-already-exact"},
    {"mutation": "earlier-gate-failed", "expectedReason": "earlier-gate-failed"},
    {"mutation": "baseline-not-better", "expectedReason": "baseline-not-strictly-better"},
    {
