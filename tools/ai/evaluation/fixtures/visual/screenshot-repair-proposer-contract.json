    },
    {
      "mutation": "localization-without-baseline-value-difference",
      "expectedReason": "no-single-localized-property-difference"
    }
  ],
  "invalidFixtures": [
    {"mutation": "changed-evidence-fingerprint", "expectedReason": "input-invalid"},
    {"mutation": "lineage-mismatch", "expectedReason": "evidence-lineage-mismatch"}
  ],
  "cancelledFixtures": [
