        "name": "text",
        "candidateValueFingerprint": "2d5a9d124f9e9914656016180d61fd19bd01b5215788700dbf90d4a808e78f34",
        "baselineValueFingerprint": "468d5410ab849597bef869faf5a61fe632a374832339a132f6a6c5b9e87b2998",
        "localizationFingerprint": "05ee59a64778fb9ca3727aa81cc6b27965ceb6cd4de86b906e558d493db28433",
        "attributedMismatchedPixels": 2267
      },
      "expectedPatch": {
        "schemaVersion": 1,
        "operations": [
          {
            "op": "replace-field",
            "nodeId": "wireframe-title",
