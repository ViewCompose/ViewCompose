{
  "schemaVersion": 1,
  "contractId": "viewcompose-generated-preview-v1",
  "requiresContracts": [
    "android-xml-layout-v1",
    "viewcompose-preview-protocol-v1",
    "generated-preview-request-v1"
  ],
  "activation": {
    "tool": "convert_xml_to_viewcompose",
    "mode": "render",
    "sourceLane": "current-source",
    "projectBuildExecution": false
  },
  "execution": {
    "harnessModule": ":tools:ai-preview-harness",
    "inputOwnership": "tool-owned content-addressed request directory",
    "readInspectedProject": false,
    "executeInspectedProjectBuildLogic": false,
    "networkAccess": false,
    "followSymbolicLinks": false,
    "callerSelectedGradleTask": false,
    "callerSelectedDependency": false,
    "callerSelectedOutputPath": false,
    "callerSuppliedKotlin": false
  },
  "source": {
    "origin": "Kotlin generated by the same accepted XML conversion",
    "packageName": "generated.viewcompose",
    "entryPointReceiver": "UiTreeBuilder",
    "fingerprint": "SHA-256 of exact generated Kotlin bytes",
    "functionSelection": "exact generator report functionName",
    "mismatch": "fail closed before Gradle execution"
  },
  "bindings": {
    "matching": "exact ordered parameter, source, and type set from the generator report",
    "missing": "fail closed",
    "extra": "fail closed",
    "duplicate": "fail closed",
    "applicationBehavior": "never invented",
    "supported": [
      {
        "type": "String",
        "requestKind": "string",
        "renderValue": "exact caller value"
      },
      {
        "type": "TextFieldState",
        "requestKind": "text-field-state",
        "renderValue": "fresh state with exact caller initialText"
      }
    ],
    "unsupported": [
      {
        "type": "ImageSource",
        "reason": "The isolated harness has no accepted asset-staging contract and cannot read inspected-project resources or use the network."
      }
    ]
  },
  "wrapper": {
    "packageName": "generated.viewcompose",
    "functionName": "GeneratedXmlPreview",
    "displayName": "Generated XML · <generated function>",
    "group": "AI/XML",
    "entryPointSignature": "fun UiTreeBuilder.GeneratedXmlPreview()",
    "generation": "deterministic exact Kotlin",
    "callerCodeExecution": false
  },
  "configuration": {
    "widthDp": 411,
    "heightDp": -1,
    "density": 2.625,
    "fontScale": 1,
    "localeTag": "en-US",
    "layoutDirection": "Ltr",
    "theme": "Light",
    "apiLevel": null,
    "matrix": "single frozen configuration in v1"
  },
  "lanes": {
    "compiler": "current-source/jdk-21/agp-9.1.1/kotlin-2.2.10/android-37/jvm-11",
    "render": "current-source/preview-protocol-1/paparazzi-2.0.0-alpha05/layoutlib-16.2.1",
    "jdkFeature": 21,
    "offline": true
  },
  "identity": {
    "requestFingerprint": "SHA-256 of canonical generated-preview request JSON",
    "wrapperFingerprint": "SHA-256 of exact generated wrapper Kotlin bytes",
    "renderFingerprint": "SHA-256 of preview.png and render-tree.json with named separators",
    "cacheScope": [
      "framework bundle fingerprint",
      "generated Kotlin fingerprint",
      "bindings",
      "configuration",
      "compiler lane",
      "render lane"
    ],
    "cacheIntegrity": "reopen and verify every declared artifact before accepting a hit"
  },
  "evidence": {
    "requiredLevel": "rendered",
    "compileBeforeRender": true,
    "requiredArtifacts": ["preview.png", "render-tree.json"],
    "requiredFields": [
      "requestFingerprint",
      "generatedKotlinFingerprint",
      "wrapperFingerprint",
      "pngSha256",
      "renderTreeSha256",
      "outputFingerprint",
      "compilerLane",
      "renderLane"
    ],
    "absolutePathsInPublicResult": false,
    "renderDiagnostics": "preserve bounded accepted Preview diagnostics"
  },
  "limits": {
    "maxGeneratedKotlinBytes": 1048576,
    "maxWrapperBytes": 262144,
    "maxBindings": 64,
    "maxBindingTextBytes": 65536,
    "maxProcessOutputBytes": 2097152,
    "maxImageBytes": 16777216,
    "maxRenderTreeBytes": 8388608,
    "timeoutMs": 120000,
    "maxConcurrentRequests": 1
  },
  "diagnosticCodes": [
    "VC-AI-PREVIEW-BINDING-DUPLICATE",
    "VC-AI-PREVIEW-BINDING-EXTRA",
    "VC-AI-PREVIEW-BINDING-MISSING",
    "VC-AI-PREVIEW-BINDING-TYPE-UNSUPPORTED",
    "VC-AI-PREVIEW-BINDING-VALUE-INVALID",
    "VC-AI-PREVIEW-BUILD-SELECTION-DENIED",
    "VC-AI-PREVIEW-GENERATED-SOURCE-MISMATCH",
    "VC-AI-PREVIEW-WRAPPER-INVALID"
  ],
  "supportedFixtures": [
    {
      "generatedKotlin": "login.viewcompose.kt",
      "request": "generated-preview/login.preview-request.json",
      "wrapper": "generated-preview/login.preview-wrapper.kt",
      "expectedFunction": "LoginView",
      "expectedBindings": 4,
      "expectedRequestFingerprint": "8b2d5460fea40ee539fc5aba01af5cac97d59002476c17b744fb7baa1144d063",
      "expectedWrapperFingerprint": "8d4ff9932ada6621a05b486a22d410d79a674db787c29ac22b1e7e4e0dcf8821"
    }
  ],
  "unsupportedFixtures": [
    {
      "request": "generated-preview/missing-binding.preview-request.json",
      "diagnosticCodes": ["VC-AI-PREVIEW-BINDING-MISSING"]
    },
    {
      "request": "generated-preview/image-binding.preview-request.json",
      "diagnosticCodes": ["VC-AI-PREVIEW-BINDING-TYPE-UNSUPPORTED"]
    },
    {
      "request": "generated-preview/build-selection.preview-request.json",
      "schemaValid": false,
      "diagnosticCodes": ["VC-AI-PREVIEW-BUILD-SELECTION-DENIED"]
    }
  ]
}
