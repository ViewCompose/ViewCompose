  "unsupportedDenominators": [
    {
      "mutation": "change canonical Design IR after generation",
      "diagnosticCodes": ["VC-AI-COMPARE-DESIGN-IR-MISMATCH"]
    },
    {
      "mutation": "change render-tree bytes or declared fingerprint",
      "diagnosticCodes": ["VC-AI-COMPARE-RENDER-EVIDENCE-MISMATCH"]
    },
    {
      "mutation": "duplicate one normalized authored key",
      "diagnosticCodes": ["VC-AI-COMPARE-NODE-AMBIGUOUS"]
    },
    {
      "mutation": "change one mapped semantic kind",
      "diagnosticCodes": ["VC-AI-COMPARE-KIND-MISMATCH"]
    },
    {
      "mutation": "move one exact-dp node by one pixel",
      "diagnosticCodes": ["VC-AI-COMPARE-GEOMETRY-MISMATCH"]
    }
  ]
}
