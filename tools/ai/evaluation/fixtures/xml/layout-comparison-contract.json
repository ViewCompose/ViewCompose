{
  "schemaVersion": 1,
  "contractId": "viewcompose-generated-layout-comparison-v1",
  "requiresContracts": [
    "design-ir-v1",
    "viewcompose-generated-preview-v1",
    "viewcompose-preview-protocol-v1",
    "layout-comparison-v1"
  ],
  "activation": {
    "tool": "convert_xml_to_viewcompose",
    "mode": "render",
    "successEvidence": "compared",
    "failureEvidence": "rendered"
  },
  "input": {
    "designIr": "the exact normalized IR generated in the current conversion request",
    "previewRequest": "the exact content-addressed generated Preview request",
    "renderTree": "the contained artifact from the accepted generated Preview result",
    "callerSuppliedDesignIr": false,
    "callerSuppliedRenderTree": false,
    "callerSuppliedPolicy": false
  },
  "integrity": {
    "designIrFingerprint": "SHA-256 of canonical compact JSON",
    "previewRequestFingerprint": "must equal generated Preview evidence",
    "renderTreeFingerprint": "reopen and verify the exact declared artifact before comparison",
    "outputFingerprint": "must equal generated Preview evidence",
    "followSymbolicLinks": false,
    "absolutePathsInPublicResult": false,
    "networkAccess": false,
    "executeInspectedProjectBuildLogic": false
  },
  "identity": {
    "designNodeIdToKey": "strip one leading id: prefix; preserve every other Design IR id exactly",
    "keyMultiplicity": "exactly one virtual node",
    "nativeNodeIdentity": "exact virtual nodeId",
    "extraAuthoredKeys": "fail comparison",
    "frameworkRootWithoutNodeId": "ignored",
    "syntheticNodes": "fail comparison unless allowlisted by semanticHostWrappers"
  },
  "semanticHostWrappers": [
    {
      "designKind": "text-field",
      "identityRenderKind": "column",
      "semanticRenderKind": "text-field",
      "maxDepth": 1,
      "requirements": [
        "exactly one child",
        "child key is absent",
        "identity and semantic host bounds are equal"
      ]
    }
  ],
  "kindMapping": {
    "box": "box",
    "button": "button",
    "column": "column",
    "image": "image",
    "text": "text",
    "text-field": "text-field"
  },
  "semantics": {
    "resourceResolution": "only exact string Preview bindings with the same source identity",
    "checked": [
      "kind",
      "declared parent and child order",
      "visible text",
      "content description",
      "declared semantic role",
      "visibility"
    ],
    "notClaimed": [
      "text-field placeholder when absent from render-tree properties",
      "state ownership or mutations",
      "event behavior",
      "focus traversal",
      "complete accessibility behavior",
      "style or pixel similarity"
    ]
  },
  "geometry": {
    "coordinateSpace": "render-tree integer pixels in the accepted screenshot viewport",
    "dpConversion": "round(value * density) to nearest integer pixel",
    "tolerancePx": 0,
    "checked": [
      "exact dp width and height",
      "root match-parent width and height",
      "child match-parent width inside declared parent padding",
      "uniform padding anchor and trailing inset where observable",
      "parent containment",
      "column sibling order"
    ],
    "wrapContent": "record actual bounds but do not claim a target size",
    "gone": "require GONE and zero or absent visible bounds; size checks are not applicable",
    "notClaimed": [
      "perceptual or pixel similarity",
      "typography metrics",
      "color",
      "draw order",
      "touch target",
      "multiple device configurations"
    ]
  },
  "evidence": {
    "schema": "layout-comparison-v1",
    "passLevel": "compared",
    "mismatchLevel": "rendered",
    "allRequiredChecksMustPass": true,
    "oneAggregateScore": false,
    "categories": ["identity", "structure", "semantic", "geometry"],
    "comparisonFingerprint": "SHA-256 of canonical compact result without comparisonFingerprint"
  },
  "limits": {
    "maxDesignNodes": 1000,
    "maxVirtualNodes": 2000,
    "maxNativeNodes": 4000,
    "maxDepth": 64,
    "maxRenderTreeBytes": 8388608,
    "maxChecksPerNode": 128,
    "maxFindings": 1000,
    "maxWrapperDepth": 1
  },
  "diagnosticCodes": [
    "VC-AI-COMPARE-INPUT-INVALID",
    "VC-AI-COMPARE-DESIGN-IR-MISMATCH",
    "VC-AI-COMPARE-RENDER-EVIDENCE-MISMATCH",
    "VC-AI-COMPARE-RENDER-TREE-INVALID",
    "VC-AI-COMPARE-NODE-MISSING",
    "VC-AI-COMPARE-NODE-AMBIGUOUS",
    "VC-AI-COMPARE-KIND-MISMATCH",
    "VC-AI-COMPARE-STRUCTURE-MISMATCH",
    "VC-AI-COMPARE-SEMANTIC-MISMATCH",
    "VC-AI-COMPARE-GEOMETRY-MISMATCH",
    "VC-AI-COMPARE-LIMIT"
  ],
