{
  "schemaVersion": 1,
  "contractId": "viewcompose-ai-metrics-v1",
  "metrics": [
    {
      "id": "knowledge.deterministic-output",
      "phase": 1,
      "measure": "mismatch_count",
      "direction": "at_most",
      "threshold": 0,
      "unit": "files",
      "environment": "same source revision and generator version"
    },
    {
      "id": "knowledge.capability-completeness",
      "phase": 1,
      "measure": "resolved_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "current canonical capability inventory"
    },
    {
      "id": "retrieval.top5-recall",
      "phase": 1,
      "measure": "top5_recall",
      "direction": "at_least",
      "threshold": 0.95,
      "unit": "ratio",
      "environment": "local index, cold process, current-source lane"
    },
    {
      "id": "retrieval.exact-symbol-rank",
      "phase": 1,
      "measure": "reciprocal_rank",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "exact fully-qualified symbol query"
    },
    {
      "id": "validation.fabricated-symbol-rejection",
      "phase": 2,
      "measure": "rejection_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "curated nonexistent and removed symbol corpus"
    },
    {
      "id": "validation.rule-precision",
      "phase": 2,
      "measure": "precision",
      "direction": "at_least",
      "threshold": 0.95,
      "unit": "ratio",
      "environment": "per stable rule code on labeled fixtures"
    },
    {
      "id": "validation.rule-recall",
      "phase": 2,
      "measure": "recall",
      "direction": "at_least",
      "threshold": 0.9,
      "unit": "ratio",
      "environment": "per stable rule code on labeled fixtures"
    },
    {
      "id": "compile.supported-success",
      "phase": 2,
      "measure": "success_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "pinned JDK, Kotlin, AGP, Android SDK, artifacts, and supported fixtures"
    },
    {
      "id": "render.supported-success",
      "phase": 2,
      "measure": "success_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "pinned Preview runner and declared configuration matrix"
    },
    {
      "id": "security.fail-closed",
      "phase": 2,
      "measure": "blocked_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "adversarial path, build execution, secret, resource, timeout, cancellation, and cache fixtures"
    },
    {
      "id": "runtime.isolation",
      "phase": 2,
      "measure": "release_runtime_occurrences",
      "direction": "at_most",
      "threshold": 0,
      "unit": "dependencies_or_operations",
      "environment": "release dependency graph and inactive application process"
    },
    {
      "id": "protocol.cli-mcp-parity",
      "phase": 3,
      "measure": "semantic_mismatch_count",
      "direction": "at_most",
      "threshold": 0,
      "unit": "cases",
      "environment": "same core request and knowledge fingerprint"
    },
    {
      "id": "layout.diagnosis-exactness",
      "phase": 3,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "accepted Preview protocol v1 layout diagnostics with fixed code mapping"
    },
    {
      "id": "workflow.contract-completeness",
      "phase": 3,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "checked-in client-neutral skill manifest against the frozen workflow set"
    },
    {
      "id": "distribution.reproducible-package",
      "phase": 3,
      "measure": "sha256_mismatch_count",
      "direction": "at_most",
      "threshold": 0,
      "unit": "archives",
      "environment": "two clean local package builds from the same source tree and npm version"
    },
    {
      "id": "distribution.offline-lifecycle",
      "phase": 3,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "isolated prefix, local tarball, unreachable registry, npm offline mode"
    },
    {
      "id": "distribution.inventory-completeness",
      "phase": 3,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "archive manifest, SHA-256 sidecars, SPDX 2.3 package record, and MIT license inventory"
    },
    {
      "id": "protocol.installed-compatibility",
      "phase": 3,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "installed stdio package against every frozen modern and legacy MCP version"
    },
    {
      "id": "design-ir.schema-conformance",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "every declared Design IR v1 golden and converter output"
    },
    {
      "id": "design-ir.deterministic-output",
      "phase": 4,
      "measure": "byte_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "two conversions of each supported source identity with identical bytes"
    },
    {
      "id": "design-ir.provenance-completeness",
      "phase": 4,
      "measure": "complete_node_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "every emitted node has source id, source span, confidence, and mapping decision"
    },
    {
      "id": "xml.supported-compile",
      "phase": 4,
      "measure": "success_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "declared supported XML subset"
    },
    {
      "id": "xml.resource-preservation",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "declared XML resource references against IR and generated parameter bindings"
    },
    {
      "id": "xml.project-resource-resolution",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "explicit project-relative resource roots, default values definitions, no AGP execution"
    },
    {
      "id": "xml.project-style-resolution",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "bounded explicit style parents, supported items, and inline override precedence"
    },
    {
      "id": "xml.callsite-inventory-exactness",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "bounded read-only Kotlin and Java lexical inventory with explicit candidate confidence"
    },
    {
      "id": "xml.layout-dependency-exactness",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "ordered explicit resource roots, default layout files, stable include edges, no AGP execution"
    },
    {
      "id": "xml.include-merge-expansion",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "bounded project-only include and merge fixtures with cross-file provenance"
    },
    {
      "id": "xml.generated-preview-render-success",
      "phase": 4,
      "measure": "success_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "source-bound XML-generated Kotlin, exact bindings, fixed Preview configuration, and pinned offline render lane"
    },
    {
      "id": "xml.generated-preview-binding-exactness",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "generator-reported binding parameter, source, type, order, and explicitly supported preview values"
    },
    {
      "id": "xml.generated-preview-asset-integrity",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "canonical embedded PNG bytes with exact size, SHA-256, dimensions, chunk structure, CRC, immutable staging, and no path or network input"
    },
    {
      "id": "xml.generated-preview-isolation",
      "phase": 4,
      "measure": "blocked_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "fixed tool-owned harness with no inspected-project build, caller task, dependency, output path, network, or symlink traversal"
    },
    {
      "id": "xml.generated-layout-semantic-exactness",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "canonical Design IR against the exact accepted render tree; unique normalized keys, allowlisted semantic hosts, structure, observable text, roles, content descriptions, and visibility"
    },
    {
      "id": "xml.generated-layout-geometry-exactness",
      "phase": 4,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "single frozen Preview configuration; integer bounds, nearest-pixel dp conversion, zero tolerance, declared dimensions, padding, containment, and column order"
    },
    {
      "id": "migration.unsupported-honesty",
      "phase": 4,
      "measure": "reported_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "labeled unsupported XML and Compose semantics"
    },
    {
      "id": "visual.semantic-preservation",
      "phase": 5,
      "measure": "exact_match_ratio",
      "direction": "at_least",
      "threshold": 1,
      "unit": "ratio",
      "environment": "declared text, role, state, content-description, and traversal expectations"
    },
    {
      "id": "visual.geometry-pass",
      "phase": 5,
      "measure": "nodes_within_tolerance_ratio",
      "direction": "at_least",
      "threshold": 0.98,
      "unit": "ratio",
      "environment": "same density, viewport, font, locale, and system-bar crop; tolerance max(2 px, 1 percent)"
    },
    {
      "id": "visual.repair-bound",
      "phase": 5,
      "measure": "iterations",
      "direction": "at_most",
      "threshold": 5,
      "unit": "iterations",
      "environment": "no oscillation and no regression of passed deterministic gates"
    }
  ]
}
