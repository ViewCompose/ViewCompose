<idea-plugin url="https://github.com/ViewCompose/ViewCompose">
    <id>com.viewcompose.studio.preview</id>
    <name>ViewCompose Preview</name>
    <vendor>ViewCompose</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.androidstudio</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.gradle</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.android</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <!--suppress PluginXmlValidity -->
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="com.viewcompose.studio.preview.ViewComposePreviewLineMarkerProvider"/>
        <toolWindow
            id="ViewCompose Preview"
            anchor="right"
            icon="/icons/viewcomposePreview.svg"
            factoryClass="com.viewcompose.studio.preview.ViewComposePreviewToolWindowFactory"/>
    </extensions>

    <actions>
        <action
            id="com.viewcompose.studio.preview.LocateDeviceDsl"
            class="com.viewcompose.studio.preview.LocateDeviceDslAction"
            text="Locate Device DSL"
            description="Open the ViewCompose DSL currently visible on a connected Android device"
            icon="/icons/viewcomposeLocateDeviceDsl.svg">
            <add-to-group group-id="Android.MainToolbarRight" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="com.viewcompose.studio.preview.HighlightDeviceDslNode"
            class="com.viewcompose.studio.preview.HighlightDeviceDslNodeAction"
            text="Highlight Device DSL Node"
            description="Select and briefly highlight one mounted ViewCompose node on a connected Android device"
            icon="/icons/viewcomposeLocateDeviceDsl.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="com.viewcompose.studio.preview.ClearDeviceDslHighlight"
            class="com.viewcompose.studio.preview.ClearDeviceDslHighlightAction"
            text="Clear Device DSL Highlight"
            description="Clear the current ViewCompose node highlight on a connected Android device"
            icon="/icons/viewcomposeLocateDeviceDsl.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="com.viewcompose.studio.preview.InspectDeviceAnimationTimeline"
            class="com.viewcompose.studio.preview.InspectDeviceAnimationTimelineAction"
            text="Inspect Device Animation Timeline"
            description="Capture a bounded read-only ViewCompose animation timeline from a connected Android device"
            icon="/icons/viewcomposePreview.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
