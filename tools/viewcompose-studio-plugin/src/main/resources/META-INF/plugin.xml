<idea-plugin>
    <id>com.viewcompose.studio.preview</id>
    <name>ViewCompose Preview</name>
    <vendor>ViewCompose</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.gradle</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <!--suppress PluginXmlValidity -->
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="com.viewcompose.studio.preview.ViewComposePreviewLineMarkerProvider"/>
        <toolWindow
            id="ViewCompose Preview"
            anchor="right"
            icon="/icons/viewcomposePreview.svg"
            factoryClass="com.viewcompose.studio.preview.ViewComposePreviewToolWindowFactory"/>
    </extensions>
</idea-plugin>
