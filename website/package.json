{
  "name": "viewcompose-documentation",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate:catalog": "node scripts/generate-module-catalog.mjs && node scripts/generate-versioned-module-manuals.mjs",
    "write-translations": "docusaurus write-translations --locale zh-CN",
    "prestart": "npm run generate:catalog",
    "start": "docusaurus start",
    "prebuild": "npm run generate:catalog && npm run verify:languages && npm run verify:translations",
    "build": "node scripts/build-site.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "test:translations": "node --test scripts/__tests__/verify-translations.test.mjs",
    "test:languages": "node --test scripts/__tests__/verify-document-languages.test.mjs",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "verify:languages": "npm run test:languages && node scripts/verify-document-languages.mjs",
    "verify:translations": "node scripts/verify-translations.mjs",
    "verify:accessibility": "node scripts/verify-accessibility.mjs",
    "verify:budgets": "node scripts/verify-site-budgets.mjs",
    "verify:versions": "node scripts/verify-versioned-documentation.mjs",
    "verify:site": "node scripts/verify-site-quality.mjs",
    "typecheck": "npm run generate:catalog && npm run verify:languages && npm run verify:translations && tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "cheerio": "1.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "serialize-javascript": "7.0.7",
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=20.0"
  },
  "packageManager": "npm@11.8.0"
}
